{
  "name": "bb-plugin-lobu",
  "version": "0.4.1",
  "description": "Lobu in bb: save what your agents learn to Lobu memory and start threads with it, with setup that installs the Lobu CLI and signs you in.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobu-ai/bb-plugin-lobu.git"
  },
  "bugs": {
    "url": "https://github.com/lobu-ai/bb-plugin-lobu/issues"
  },
  "homepage": "https://github.com/lobu-ai/bb-plugin-lobu#readme",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "Lobu",
    "description": "Save what your agents learn to Lobu memory and start every thread with it.",
    "branding": {
      "icon": "./icons/lobu.svg",
      "logo": {
        "light": "./icons/lobu-logo.svg"
      },
      "experimental_icons": {
        "lobu": "./icons/lobu.svg",
        "refresh": "./icons/refresh.svg",
        "pin": "./icons/pin.svg",
        "undo": "./icons/undo.svg",
        "search": "./icons/search.svg",
        "memory": "./icons/memory.svg",
        "plus": "./icons/plus.svg",
        "close": "./icons/close.svg",
        "given": "./icons/given.svg",
        "folder": "./icons/folder.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "build": "bb plugin build"
  },
  "files": [
    "app.tsx",
    "server.ts",
    "components",
    "lib",
    "icons",
    "components.json",
    "tsconfig.json",
    "dist"
  ],
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@types/better-sqlite3": "^7.6.12",
    "@types/bun": "^1.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.14",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
